DATABASE_URL=mysql+pymysql://root:password@localhost:3306/hamdan_erp
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# Path to the mysqldump executable, used by Admin Utilities > Backup.
# Defaults to "mysqldump" (works if it's on PATH); on Windows you likely need the
# full path, e.g. C:\Program Files\MySQL\MySQL Server 8.4\bin\mysqldump.exe
MYSQLDUMP_PATH=mysqldump

# Twilio (https://console.twilio.com) - required for WhatsApp/SMS sending to work.
# Leave blank to run without messaging; sends will be logged as Failed until set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
